specification {
  element person {
    style {
      shape person
    }
  }

  element zone {
    style {
      shape rectangle
      color muted
    }
  }

  element system
  element container

  element database {
    style {
      shape cylinder
    }
  }

  element queue {
    style {
      shape queue
    }
  }

  relationship otlp {
    technology 'OTLP / Bearer'
    color blue
  }

  relationship kafka {
    technology 'Kafka / SASL'
    color amber
    line dotted
  }

  relationship storage {
    color green
  }

  relationship control {
    technology 'OpAMP'
    color red
    line dotted
  }

  relationship administration {
    technology 'HTTP'
    color red
    line dotted
  }

  relationship business {
    technology 'HTTP / Kafka métier'
    color gray
  }

  relationship logs {
    technology 'Logs'
    color amber
  }

  relationship metrics {
    technology 'Métriques'
    color green
  }

  relationship traces {
    technology 'Traces'
    color blue
  }
}

model {
  business_user = person 'Utilisateur métier' 'Utilise les APIs de l’application pour consulter ou modifier les données métier'
  operator = person 'Opérateur plateforme' 'Consulte Kibana, vérifie les signaux et administre la plateforme depuis Git'

  zone0 = zone 'Zone 0 - gestion' {
    hub = system 'tools-01' 'Cluster k3s de gestion (hub) : pilote les clusters cibles depuis Git' {
      argocd = container 'Argo CD' 'GitOps' 'Synchronise gitops/ depuis GitHub : groupes, opérateurs (Helm), collecteurs'
      crossplane = container 'Crossplane' 'Compositions et providers' 'Compose les objets des clusters cibles (provider-kubernetes) et configure les back-ends'
    }
  }

  zone1 = zone 'Zone 1 - applications, back-ends et Edge' {
    kubernetes = system 'k3s-01' 'Cluster k3s applicatif' {
      applications = container 'Applications métier' 'Spring Boot / Java' 'Produisent logs, métriques et traces OTLP'
      k8s_collectors = container 'Collecteurs Kubernetes' 'EDOT Collector' 'Métriques des nœuds, des pods et du cluster ; supervision de PostgreSQL, MongoDB et Kafka (otel-middleware)'
      kafka = queue 'Kafka métier' 'Strimzi : topics des applications'
      data = container 'Bases de données' 'PostgreSQL (CloudNativePG) / MongoDB' 'Données du scénario supermarché'
      otel_kafka = queue 'Kafka OTel' 'Strimzi : topics otel-* protégés par SCRAM et ACL'
      backend_collector = container 'Backend OTel' 'EDOT Collector' 'Consomme les topics otel-* par regex et indexe en OTel natif'
      edge_collector = container 'Collector Edge' 'EDOT Collector' 'Reçoit OTLP authentifié par Bearer (Service otel-edge, ports d’hôte 4317/4318) et publie dans Kafka OTel'
      k3s_agent = container 'Agent EDOT' 'Elastic Agent standalone' 'Collecte les signaux de la VM'
    }
  }

  zone3 = zone 'Zone 3 - plateforme Elastic' {
    elk = system 'elk-01' 'Cluster k3s + ECK : stockage, supervision et consultation' {
      elasticsearch = database 'Elasticsearch' 'Stocke logs, métriques et traces (OTel natif)'
      fleet = container 'Fleet Server' 'Fleet / OpAMP' 'Supervise les agents EDOT'
      kibana = container 'Kibana' 'Kibana' 'Consultation et administration'
      elk_agent = container 'Agent EDOT' 'Elastic Agent standalone' 'Collecte les signaux de la VM'
    }
  }

  operator .administration zone0.hub.argocd 'Pousse la configuration sur main (GitHub)'
  zone0.hub.argocd .control zone0.hub.crossplane 'Synchronise les API du lab et les providers'
  zone0.hub.argocd .control zone1.kubernetes 'Installe les opérateurs et les collecteurs'
  zone0.hub.argocd .control zone3.elk 'Installe ECK'
  zone0.hub.crossplane .control zone1.kubernetes 'Compose services, bases, Kafka ; configure comptes, topics et ACL'
  zone0.hub.crossplane .control zone3.elk 'Compose Elasticsearch, Kibana, Fleet Server ; configure ILM, Fleet, dashboards'

  business_user .business zone1.kubernetes.applications 'Utilise les APIs métier'
  zone1.kubernetes.applications .business zone1.kubernetes.kafka 'Publie et consomme les événements métier'
  zone1.kubernetes.applications .business zone1.kubernetes.data 'Lit et écrit les données'

  zone1.kubernetes.applications .traces zone1.kubernetes.edge_collector 'Envoie les traces applicatives'
  zone1.kubernetes.applications .metrics zone1.kubernetes.edge_collector 'Envoie les métriques applicatives'
  zone1.kubernetes.applications .logs zone1.kubernetes.edge_collector 'Envoie les logs applicatifs (agent OTel)'
  zone1.kubernetes.k8s_collectors .metrics zone1.kubernetes.edge_collector 'Envoie les métriques Kubernetes et des back-ends'
  zone1.kubernetes.data .storage zone1.kubernetes.k8s_collectors 'Expose ses métriques et ses requêtes'
  zone1.kubernetes.k3s_agent .metrics zone1.kubernetes.edge_collector 'Envoie les métriques VM'
  zone3.elk.elk_agent .metrics zone1.kubernetes.edge_collector 'Envoie les métriques VM'

  zone1.kubernetes.edge_collector .logs zone1.kubernetes.otel_kafka 'Publie otel-logs-<plateforme>-<env> (SCRAM)'
  zone1.kubernetes.edge_collector .metrics zone1.kubernetes.otel_kafka 'Publie otel-metrics-<plateforme>-<env>'
  zone1.kubernetes.edge_collector .traces zone1.kubernetes.otel_kafka 'Publie otel-traces-<plateforme>-<env>'
  zone1.kubernetes.otel_kafka .logs zone1.kubernetes.backend_collector 'Consomme otel-logs-*'
  zone1.kubernetes.otel_kafka .metrics zone1.kubernetes.backend_collector 'Consomme otel-metrics-*'
  zone1.kubernetes.otel_kafka .traces zone1.kubernetes.backend_collector 'Consomme otel-traces-*'
  zone1.kubernetes.backend_collector .logs zone3.elk.elasticsearch 'Indexe les logs dans les data streams'
  zone1.kubernetes.backend_collector .metrics zone3.elk.elasticsearch 'Indexe les métriques dans les data streams'
  zone1.kubernetes.backend_collector .traces zone3.elk.elasticsearch 'Indexe les traces OTel natives'

  operator .administration zone3.elk.elasticsearch 'Accède directement à Elasticsearch'
  operator .administration zone3.elk.kibana 'Accède directement à Kibana'
  operator .administration zone3.elk.fleet 'Supervise les agents via Fleet'

  zone1.kubernetes.k3s_agent .control zone3.elk.fleet 'Supervision OpAMP'
  zone3.elk.elk_agent .control zone3.elk.fleet 'Supervision OpAMP'
}

views {
  view architecture {
    title 'Architecture observabilité SystemLens'
    description '''
      Vue C4 conteneurs : un hub de gestion (tools-01) et trois zones réseau.

      Le hub synchronise depuis Git (Argo CD) et compose (Crossplane) le
      contenu des clusters cibles k3s-01 et elk-01.

      Le flux métier part de l’utilisateur vers les applications, qui
      échangent leurs événements par le Kafka métier.

      Le flux d’observabilité part des applications, des collecteurs Kubernetes
      et des agents EDOT, traverse l'Edge (OTLP) puis le Kafka OTel, et se
      termine dans les data streams Elasticsearch avant consultation dans Kibana.

      Les flux rouges représentent le plan d’administration et de contrôle.
    '''
    include operator
    include zone0.**
    include zone1.**
    include zone3.**
  }

  view business-flow {
    title 'Flux métier'
    description 'Un utilisateur appelle les APIs ; les applications échangent les événements métier via Kafka et lisent leurs bases.'
    include business_user
    include zone1.kubernetes.applications
    include zone1.kubernetes.kafka
    include zone1.kubernetes.data
  }

  view observability-flow {
    title 'Flux de télémétrie'
    description 'Les signaux sont collectés en OTLP, bufferisés dans Kafka OTel, indexés dans Elasticsearch, puis consultés dans Kibana.'
    include zone1.kubernetes.applications
    include zone1.kubernetes.k8s_collectors
    include zone1.kubernetes.k3s_agent
    include zone1.kubernetes.edge_collector
    include zone1.kubernetes.otel_kafka
    include zone1.kubernetes.backend_collector
    include zone3.elk.elasticsearch
    include operator
    include zone3.elk.kibana
  }

  view signals-flow {
    title 'Remontée des logs, métriques et traces'
    description '''
      Les trois signaux suivent le même chemin de collecte et de bufferisation
      jusqu’au backend OTel de k3s-01, qui les indexe en OTel natif dans
      Elasticsearch.

      Orange : logs. Vert : métriques. Bleu : traces.
    '''
    include zone1.kubernetes.applications
    include zone1.kubernetes.k8s_collectors
    include zone1.kubernetes.edge_collector
    include zone1.kubernetes.otel_kafka
    include zone1.kubernetes.backend_collector
    include zone3.elk.elasticsearch
    include zone3.elk.kibana
  }

  view management {
    title 'Gestion depuis le hub'
    description 'Argo CD et Crossplane, dans tools-01, déploient et configurent les clusters cibles depuis Git.'
    include operator
    include zone0.**
    include zone1.kubernetes
    include zone3.elk
  }
}
