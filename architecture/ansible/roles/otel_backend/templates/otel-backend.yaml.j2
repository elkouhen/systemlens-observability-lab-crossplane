extensions:
  # Documentation : https://github.com/open-telemetry/opentelemetry-collector-contrib/tree/main/extension/healthcheckextension
  health_check:
    endpoint: 0.0.0.0:13134
  # Documentation : https://github.com/open-telemetry/opentelemetry-collector-contrib/tree/main/extension/storage/filestorage
  file_storage:
    directory: /var/lib/otel

receivers:
  # Documentation : https://github.com/open-telemetry/opentelemetry-collector-contrib/tree/main/receiver/kafkareceiver
  kafka/otlp:
    brokers: ["{{ otel_kafka_broker }}"]
    # Pas de protocol_version (ADR-013) : franz-go négocie avec le broker la
    # version de chaque requête (ApiVersions).
    group_id: otel-backend
    # Souscription par expression régulière : un topic par plateforme et
    # environnement, otel-<signal>-<plateforme>-<environnement> (ADR-015).
    # Les nouveaux topics sont découverts à chaque rafraîchissement des
    # métadonnées, sans redémarrage du collecteur. Encodage otlp_proto par
    # défaut.
{% for signal in ['traces', 'metrics', 'logs'] %}
    {{ signal }}:
      topics: ["^otel-{{ signal }}-[a-z0-9_]+-[a-z0-9_]+$"]
{% endfor %}
    # Une partition sans offset commité (topic nouvellement découvert) est
    # lue depuis le début.
    initial_offset: earliest
    metadata:
      refresh_interval: 1m
    # Garantie de livraison (ADR-013) : un message n'est marqué, donc son
    # offset commité, qu'après son écriture dans la file persistante de
    # l'exporteur. Une erreur transitoire (file pleine, memory_limiter)
    # laisse le message non marqué et error_backoff le relit. Une erreur
    # permanente (message illisible) marque le message : il est perdu, mais
    # il ne bloque pas sa partition.
    message_marking:
      after: true
      on_error: false
      on_permanent_error: true
    error_backoff:
      enabled: true
      initial_interval: 1s
      max_interval: 30s
      max_elapsed_time: 5m
    auth:
      sasl:
        username: "${env:OTEL_KAFKA_CONSUMER_USERNAME}"
        password: "${env:OTEL_KAFKA_CONSUMER_PASSWORD}"
        mechanism: SCRAM-SHA-512

  # Documentation : https://github.com/open-telemetry/opentelemetry-collector/tree/main/receiver/otlpreceiver
  otlp/internal:
    protocols:
      grpc:
        endpoint: 127.0.0.1:4322

processors:
  memory_limiter:
    check_interval: 1s
    limit_mib: 700
    spike_limit_mib: 150
  # L'exporteur Elasticsearch n'indexe pas les histogrammes cumulatifs
  # (agent Java, télémétrie interne).
  cumulative_to_delta:
    include:
      metric_types:
        - histogram
  # Seuls les pipelines de télémétrie interne passent par batch : sur les
  # pipelines Kafka, batch acquitterait avant l'export et annulerait
  # message_marking.after ; la file de l'exporteur regroupe après
  # persistance (ADR-013).
  batch:
    timeout: 1s
    send_batch_size: 512
  # Les métriques Java du client Kafka (kafka.consumer.*.avg/.max) valent
  # NaN tant qu'aucune mesure n'existe ; l'exporteur Elasticsearch les
  # rejette. x - x est différent de 0 seulement pour NaN et ±Inf.
  # Documentation : https://github.com/open-telemetry/opentelemetry-collector-contrib/tree/main/processor/filterprocessor
  filter/invalid-double:
    error_mode: ignore
    metric_conditions:
      - (metric.type == METRIC_DATA_TYPE_GAUGE or metric.type == METRIC_DATA_TYPE_SUM) and datapoint.value_double - datapoint.value_double != 0.0
  # Data stream par plateforme (ADR-019, ADR-020) : chaque ressource déclare
  # platform.id et deployment.environment.name, contrôlés par l'Edge ; le
  # namespace vaut <plateforme>_<environnement>, le dataset est celui du
  # receiver, generic pour l'OTLP des applications, ou collectortelemetry.
  # deployment.environment est l'ancien nom de la convention sémantique,
  # cible de l'alias service.environment des templates OTel d'Elasticsearch
  # (semconv-resource-to-ecs@mappings), par lequel l'UI APM filtre les
  # signaux d'un service. otel.kafka.topic, posé par l'Edge pour son
  # exporteur Kafka, n'est pas indexé.
  # Documentation : https://github.com/open-telemetry/opentelemetry-collector-contrib/tree/main/processor/transformprocessor
  transform/data-stream-namespace:
    error_mode: ignore
    trace_statements:
      - &data_stream_namespace
        context: resource
        conditions:
          - resource.attributes["platform.id"] != nil and resource.attributes["deployment.environment.name"] != nil
        statements:
          - set(resource.attributes["data_stream.namespace"], Concat([resource.attributes["platform.id"], resource.attributes["deployment.environment.name"]], "_"))
          - set(resource.attributes["deployment.environment"], resource.attributes["deployment.environment.name"])
          - delete_key(resource.attributes, "otel.kafka.topic")
    metric_statements:
      - *data_stream_namespace
    log_statements:
      - *data_stream_namespace
  # Enrichissement des traces pour l'UI APM, en OTel natif (ADR-018) :
  # transactions, spans, service et environnement.
  # Documentation : https://www.elastic.co/docs/reference/edot-collector/components/elasticapmprocessor
  elasticapm: {}

connectors:
  # Métriques agrégées de l'UI APM (débit, latence, erreurs, dépendances),
  # calculées depuis les traces et indexées en OTel natif (ADR-018).
  # Documentation : https://www.elastic.co/docs/reference/edot-collector/components/elasticapmconnector
  elasticapm: {}

exporters:
  # Mode de mapping OTel natif pour tous les signaux : data streams
  # <type>-<dataset>.otel-<plateforme>_<environnement> (ADR-012, ADR-018,
  # ADR-019). La file persistante survit à un redémarrage du collecteur et à
  # une panne d'Elasticsearch ; pleine, elle refuse les données et le
  # receiver Kafka relit le message (ADR-013).
  # Documentation : https://github.com/open-telemetry/opentelemetry-collector-contrib/tree/main/exporter/elasticsearchexporter
  elasticsearch/otel:
    endpoints: ["{{ elasticsearch_url }}"]
    api_key: ${env:ELASTICSEARCH_API_KEY}
    mapping:
      mode: otel
    sending_queue:
      enabled: true
      queue_size: 1000
      storage: file_storage
    # Réessais explicites (ADR-013) : erreurs de transport et 429. Les 5xx ne
    # sont pas réessayés, pour éviter les doublons d'un bulk partiellement
    # indexé.
    retry:
      enabled: true
      max_retries: 10
      initial_interval: 1s
      max_interval: 1m
      retry_on_status: [429]

service:
  extensions: [health_check, file_storage]
  # Télémétrie interne (ADR-013) : niveau normal, export toutes les 30 s,
  # logs au niveau info (défaut), sans traces. Elle ne passe pas par Kafka ;
  # la ressource déclare la plateforme et l'environnement de la VM comme
  # tout client (ADR-020), avec le dataset collectortelemetry.
  telemetry:
    resource:
      attributes:
        - name: service.name
          value: otel-backend
        - name: service.version
          value: "{{ elastic_agent_version }}"
        - name: service.instance.id
          value: "{{ inventory_hostname }}"
        - name: host.name
          value: "{{ inventory_hostname }}"
        - name: platform.id
          value: "{{ otel_platform }}"
        - name: deployment.environment.name
          value: "{{ otel_environment }}"
        - name: data_stream.dataset
          value: collectortelemetry
    metrics:
      level: normal
      readers:
        - periodic:
            interval: 30000
            exporter:
              # Documentation : https://github.com/open-telemetry/opentelemetry-collector/tree/main/exporter/otlpexporter
              otlp:
                protocol: grpc
                endpoint: http://127.0.0.1:4322
    logs:
      processors:
        - batch:
            exporter:
              # Documentation : https://github.com/open-telemetry/opentelemetry-collector/tree/main/exporter/otlpexporter
              otlp:
                protocol: grpc
                endpoint: http://127.0.0.1:4322
  pipelines:
    metrics/internal-telemetry:
      receivers: [otlp/internal]
      processors: [memory_limiter, transform/data-stream-namespace, cumulative_to_delta, batch]
      exporters: [elasticsearch/otel]
    logs/internal-telemetry:
      receivers: [otlp/internal]
      processors: [memory_limiter, transform/data-stream-namespace, batch]
      exporters: [elasticsearch/otel]
    traces:
      receivers: [kafka/otlp]
      processors: [memory_limiter, transform/data-stream-namespace, elasticapm]
      exporters: [elasticapm, elasticsearch/otel]
    metrics/aggregated-otel-metrics:
      receivers: [elasticapm]
      exporters: [elasticsearch/otel]
    metrics:
      receivers: [kafka/otlp]
      processors: [memory_limiter, filter/invalid-double, transform/data-stream-namespace, cumulative_to_delta]
      exporters: [elasticsearch/otel]
    logs:
      receivers: [kafka/otlp]
      processors: [memory_limiter, transform/data-stream-namespace]
      exporters: [elasticsearch/otel]
