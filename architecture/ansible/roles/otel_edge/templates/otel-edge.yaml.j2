extensions:
  # Documentation : https://github.com/open-telemetry/opentelemetry-collector-contrib/tree/main/extension/bearertokenauth
  bearertokenauth/clients:
    filename: /etc/otel/edge.tokens
  # Documentation : https://github.com/open-telemetry/opentelemetry-collector-contrib/tree/main/extension/healthcheckextension
  health_check:
    endpoint: 0.0.0.0:13135
  # Documentation : https://github.com/open-telemetry/opentelemetry-collector-contrib/tree/main/extension/storage/filestorage
  file_storage:
    directory: /var/lib/otel-edge

receivers:
  # Documentation : https://github.com/open-telemetry/opentelemetry-collector/tree/main/receiver/otlpreceiver
  otlp:
    protocols:
      grpc:
        endpoint: 127.0.0.1:14317
        auth:
          authenticator: bearertokenauth/clients
      http:
        endpoint: 127.0.0.1:14318
        auth:
          authenticator: bearertokenauth/clients

  # Documentation : https://github.com/open-telemetry/opentelemetry-collector/tree/main/receiver/otlpreceiver
  otlp/internal:
    protocols:
      grpc:
        endpoint: 127.0.0.1:14319

processors:
  memory_limiter:
    check_interval: 1s
    limit_mib: 500
    spike_limit_mib: 100
  batch:
    timeout: 1s
    send_batch_size: 512

  # Topic Kafka par ressource (ADR-020) : le client déclare sa plateforme
  # (platform.id) et son environnement (deployment.environment.name) ; le
  # topic otel-<signal>-<plateforme>-<environnement> est posé si cette
  # plateforme est attribuée à cet Edge dans otel_platforms
  # (group_vars/all.yml). Un topic reçu est supprimé d'abord. otel.kafka.topic
  # reste sur la ressource jusqu'à l'exporteur ; le backend le supprime
  # avant l'indexation.
  # Documentation : https://github.com/open-telemetry/opentelemetry-collector-contrib/tree/main/processor/transformprocessor
  transform/kafka-topic:
    error_mode: ignore
{% for signal in ['traces', 'metrics', 'logs'] %}
    {{ signal | regex_replace('s$', '') }}_statements:
      - context: resource
        statements:
          - delete_key(resource.attributes, "otel.kafka.topic")
          - set(resource.attributes["otel.kafka.topic"], Concat(["otel-{{ signal }}", resource.attributes["platform.id"], resource.attributes["deployment.environment.name"]], "-")) where IsMatch(Concat([resource.attributes["platform.id"], resource.attributes["deployment.environment.name"]], "-"), "^({{ otel_edge_platform_keys | join('|') }})$")
{% endfor %}
  # Rejet des ressources sans plateforme servie (ADR-020) : platform.id ou
  # deployment.environment.name absent, ou plateforme non attribuée à cet
  # Edge. Les compteurs otelcol_processor_filter_{logs,datapoints,spans}_filtered
  # de ce collecteur rendent l'oubli visible (make otel-routing-verify).
  # Documentation : https://github.com/open-telemetry/opentelemetry-collector-contrib/tree/main/processor/filterprocessor
  filter/unrouted:
    error_mode: ignore
    traces:
      span:
        - resource.attributes["otel.kafka.topic"] == nil
    metrics:
      metric:
        - resource.attributes["otel.kafka.topic"] == nil
    logs:
      log_record:
        - resource.attributes["otel.kafka.topic"] == nil
exporters:
  # Documentation : https://github.com/open-telemetry/opentelemetry-collector-contrib/tree/main/exporter/kafkaexporter
  kafka/otlp:
    brokers: ["{{ otel_gateway_kafka_broker }}"]
    auth:
      sasl:
        username: "${env:OTEL_KAFKA_PUBLISHER_USERNAME}"
        password: "${env:OTEL_KAFKA_PUBLISHER_PASSWORD}"
        mechanism: SCRAM-SHA-512
    # Topic posé par transform/kafka-topic, une ressource par topic, encodage
    # otlp_proto par défaut. Les topics par défaut de l'exporteur ne
    # reçoivent rien : filter/unrouted rejette avant toute ressource sans
    # topic (ADR-015).
    topic_from_attribute: otel.kafka.topic
    # File persistante (ADR-013) : un lot accepté par l'Edge est écrit dans
    # file_storage avant l'envoi à Kafka. Il survit à un redémarrage du
    # collecteur et à une panne de Kafka ; pleine, la file refuse les données
    # et les clients OTLP réessaient. Après 30 min de réessais, un lot est
    # abandonné : un refus durable (ACL Kafka, ADR-017) ne bloque pas la file
    # des autres plateformes et reste visible dans
    # otelcol_exporter_send_failed_*.
    sending_queue:
      enabled: true
      queue_size: 1000
      storage: file_storage
    retry_on_failure:
      enabled: true
      initial_interval: 1s
      max_interval: 30s
      max_elapsed_time: 30m

service:
  extensions: [health_check, file_storage, bearertokenauth/clients]
  # Télémétrie interne (ADR-013) : niveau normal, export toutes les 30 s,
  # logs au niveau info (défaut), sans traces. La ressource déclare la
  # plateforme et l'environnement de cette VM (ADR-020), avec le dataset
  # collectortelemetry conservé.
  telemetry:
    resource:
      attributes:
        - name: service.name
          value: otel-edge
        - name: service.version
          value: "{{ elastic_agent_version }}"
        - name: service.instance.id
          value: "{{ inventory_hostname }}"
        - name: host.name
          value: "{{ inventory_hostname }}"
        - name: platform.id
          value: "{{ otel_platform }}"
        - name: deployment.environment.name
          value: "{{ otel_environment }}"
        - name: data_stream.dataset
          value: collectortelemetry
    metrics:
      level: normal
      readers:
        - periodic:
            interval: 30000
            exporter:
              # Documentation : https://github.com/open-telemetry/opentelemetry-collector/tree/main/exporter/otlpexporter
              otlp:
                protocol: grpc
                endpoint: http://127.0.0.1:14319
    logs:
      processors:
        - batch:
            exporter:
              # Documentation : https://github.com/open-telemetry/opentelemetry-collector/tree/main/exporter/otlpexporter
              otlp:
                protocol: grpc
                endpoint: http://127.0.0.1:14319
  pipelines:
    metrics/internal-telemetry:
      receivers: [otlp/internal]
      processors: [memory_limiter, transform/kafka-topic, filter/unrouted, batch]
      exporters: [kafka/otlp]
    logs/internal-telemetry:
      receivers: [otlp/internal]
      processors: [memory_limiter, transform/kafka-topic, filter/unrouted, batch]
      exporters: [kafka/otlp]
    traces:
      receivers: [otlp]
      processors: [memory_limiter, transform/kafka-topic, filter/unrouted, batch]
      exporters: [kafka/otlp]
    metrics:
      receivers: [otlp]
      processors: [memory_limiter, transform/kafka-topic, filter/unrouted, batch]
      exporters: [kafka/otlp]
    logs:
      receivers: [otlp]
      processors: [memory_limiter, transform/kafka-topic, filter/unrouted, batch]
      exporters: [kafka/otlp]
